# Copy this file to `.env` and fill in the real value.
# `.env` is git-ignored; this example file is committed.

# Formspree endpoint for the contact form.
# Create a form at https://formspree.io and paste its endpoint here.
# This is a browser-facing endpoint by design — it is safe to ship in the bundle.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/FORM_ID
