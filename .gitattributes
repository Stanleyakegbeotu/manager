# Line-ending normalisation. The repo stores LF; Netlify builds on Linux.
* text=auto eol=lf

# Binary types used by this project.
#
# These are deliberately NOT tracked by Git LFS. The Figma Make export routed
# images, PDFs and Office documents through LFS, but Netlify does not fetch LFS
# objects during a build: it would check out pointer stubs instead of the real
# files and deploy a broken portrait and a corrupt CV download. This project's
# binary assets total well under a megabyte, so plain git blobs are correct.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
